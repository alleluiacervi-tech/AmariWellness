# Copy to .env.local for local development. Never commit real secrets.

# --- Database ---------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/amari_dev

# --- Auth ---------------------------------------------------------------
# openssl rand -base64 32
SESSION_SECRET=

# --- QR signing -----------------------------------------------------
# openssl rand -base64 32
QR_SECRET=

# --- Background jobs --------------------------------------------------
# openssl rand -base64 32 — required in the Authorization header for
# GET/POST /api/cron/tick, so only your scheduler (Vercel Cron, or a
# manual call while testing) can trigger jobs. Call it every ~5 minutes:
# it expires unpaid holds, marks no-shows, completes finished sessions
# and sends the 24-hour and 2-hour reminders. Every job is safe to repeat.
# In production, .github/workflows/scheduled-jobs.yml makes that call: give
# it the same value as a GitHub Actions secret named CRON_SECRET.
CRON_SECRET=

# --- Payments (Phase 0 decision pending — see docs/phase-0-decisions.md) ---
# Leave unset to use the built-in sandbox adapter, which never moves real
# money and is safe for local development and staging.
PAYMENTS_PROVIDER=sandbox
# PAYMENTS_PROVIDER=flutterwave
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=

# --- Notifications ------------------------------------------------------
# Leave unset to use the console adapter, which logs instead of sending —
# safe for local development.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
EMAIL_FROM=book@amari.rw

WHATSAPP_PROVIDER=console
# WHATSAPP_PROVIDER=cloud_api
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

SMS_PROVIDER=console
# SMS_PROVIDER=africastalking
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
